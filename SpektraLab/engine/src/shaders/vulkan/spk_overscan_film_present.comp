#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Cmy { float cmy[]; };
layout(std430, binding = 1) readonly buffer Pblock { float P[]; };
layout(std430, binding = 2) readonly buffer Nblock { uint n[]; };
layout(std430, binding = 3) writeonly buffer OutBuf { float dst[]; };

#define P_CW 0
#define P_PX 2
#define P_A00 5
#define P_A01 6
#define P_A10 7
#define P_A11 8
#define P_CS 9
#define P_CT 10
#define P_CU 11
#define P_CV 12
#define P_FILM_W 44
#define P_PERFORATED 83
#define P_PERF_PITCH 84
#define P_PERF_W 85
#define P_PERF_H 86
#define P_PERF_EDGE 87
#define P_PERF_R 88
#define P_PERF_PHASE 89
#define P_HOLE_C 90
#define P_HOLE_M 91
#define P_HOLE_Y 92
#define P_CARRIER 199
#define P_PERF_SEED 187

uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}
uint hash_u(uint x) {
    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x;
}
float hash_f(int i, uint seed) {
    return float(hash_u(uint(i)*0x9E3779B9u ^ seed)) * (1.0/4294967295.0);
}
float value_noise(float x, uint seed) {
    float i0=floor(x), f=x-i0; float w=f*f*(3.0-2.0*f);
    return mix(hash_f(int(i0),seed), hash_f(int(i0)+1,seed), w);
}
vec2 canvas_to_film(float x, float y) {
    float u=(x+0.5)*P[P_PX]-P[P_CU];
    float v=(y+0.5)*P[P_PX]-P[P_CV];
    return vec2(P[P_A00]*u+P[P_A01]*v+P[P_CS], P[P_A10]*u+P[P_A11]*v+P[P_CT]);
}
float erf_as(float x) {
    float t=1.0/(1.0+0.3275911*abs(x));
    float y=1.0-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-0.284496736)*t+0.254829592)*t*exp(-x*x);
    return x<0.0?-y:y;
}
float perf_sdf(vec2 st, out uint hole) {
    float W=P[P_FILM_W];
    float pitch=P[P_PERF_PITCH], ph=P[P_PERF_PHASE];
    float k=floor((st.x-ph-0.5*P[P_PERF_W])/pitch+0.5);
    bool top=st.y < 0.5*W;
    uint seed=uint(P[P_PERF_SEED]);
    hole=hash_u(uint(int(k)*2+(top?0:1))*0x9E3779B9u ^ seed);
    float j0=hash_f(int(hole&0xFFFFu), seed^1u)-0.5;
    float j1=hash_f(int(hole&0xFFFFu), seed^2u)-0.5;
    float j2=hash_f(int(hole&0xFFFFu), seed^3u)-0.5;
    float j3=hash_f(int(hole&0xFFFFu), seed^4u)-0.5;
    float j4=hash_f(int(hole&0xFFFFu), seed^5u)-0.5;
    float wa=P[P_PERF_W]+0.016*j2;
    float hc=P[P_PERF_H]+0.016*j3;
    float r=clamp(P[P_PERF_R]+0.08*j4, 0.3, 0.6);
    float sc=ph+k*pitch+0.5*P[P_PERF_W]+0.020*j0;
    float tc=(top ? P[P_PERF_EDGE]+0.5*P[P_PERF_H] : W-P[P_PERF_EDGE]-0.5*P[P_PERF_H])+0.024*j1;
    vec2 q=abs(vec2(st.x-sc, st.y-tc))-vec2(0.5*wa-r, 0.5*hc-r);
    float d=length(max(q,0.0))+min(max(q.x,q.y),0.0)-r;
    float rough=0.001+0.003*hash_f(int(hole&0xFFFFu), seed^6u);
    d+=rough*(value_noise(st.x/0.05, seed^0x77u)+value_noise(st.y/0.05, seed^0x99u)-1.0)*2.0;
    return d;
}
float film_alpha(vec2 st) {
    float W=P[P_FILM_W], px=P[P_PX];
    float a = P[P_CARRIER]>1.5 ? 1.0 : clamp(min(st.y, W-st.y)/px+0.5, 0.0, 1.0);
    if (P[P_PERFORATED]>0.5) {
        uint hole;
        float sigma=sqrt(0.017*0.017+0.0961*px*px);
        float d=perf_sdf(st, hole);
        a *= 0.5+0.5*erf_as(d/(1.41421356*sigma));
    }
    return a;
}
void main() {
    uint i=spk_global_index();
    if (i>=n[0]) return;
    uint cw=uint(P[P_CW]);
    float a=film_alpha(canvas_to_film(float(i%cw), float(i/cw)));
    vec3 c=vec3(cmy[3u*i], cmy[3u*i+1u], cmy[3u*i+2u]);
    vec3 hole=vec3(P[P_HOLE_C], P[P_HOLE_M], P[P_HOLE_Y]);
    vec3 r3=a*c+(1.0-a)*hole;
    dst[3u*i]=r3.x; dst[3u*i+1u]=r3.y; dst[3u*i+2u]=r3.z;
}
